{
  "manifest_version": 3,
  "name": "Article to PDF",
  "version": "2.0.0",
  "description": "Extract the readable article from any webpage and save it as a clean PDF.",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "debugger"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Save article as PDF"
  },

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["reader.html", "reader.css", "lib/Readability.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
