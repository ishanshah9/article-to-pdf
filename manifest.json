{
  "manifest_version": 3,
  "name": "Article to PDF",
  "version": "2.1.0",
  "description": "Extract the readable article from any webpage and save it as a clean PDF.",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "debugger"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Save article as PDF"
  },

  "commands": {
    "save-pdf": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Save the current page as a PDF"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["reader.html", "reader.css", "lib/Readability.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
